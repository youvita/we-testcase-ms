{
  "name": "wetestcase-ms",
  "version": "0.1.0",
  "private": true,
  "description": "TestCase MS monorepo — web app + shared DTOs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @wetestcase/web",
    "build": "npm run build -w @wetestcase/web",
    "start": "npm run start -w @wetestcase/web",
    "start:prod": "npm run start:prod -w @wetestcase/web",
    "lint": "npm run lint -w @wetestcase/web",
    "typecheck": "npm run typecheck -w @wetestcase/dto && npm run typecheck -w @wetestcase/web",
    "db:generate": "npm run db:generate -w @wetestcase/web",
    "db:migrate": "npm run db:migrate -w @wetestcase/web",
    "db:deploy": "npm run db:deploy -w @wetestcase/web",
    "db:push": "npm run db:push -w @wetestcase/web",
    "db:studio": "npm run db:studio -w @wetestcase/web",
    "db:seed": "npm run db:seed -w @wetestcase/web",
    "tunnel:free": "./deploy/scripts/run-free-tunnel.sh",
    "tunnel:edge": "./deploy/scripts/run-edge-free-tunnel.sh",
    "edge:up": "./deploy/scripts/run-edge.sh",
    "edge:down": "docker compose -f deploy/edge/docker-compose.yml down",
    "docker:stack:up": "./deploy/scripts/stack-up.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
