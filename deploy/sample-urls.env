# Stable local URLs for this Mac mini stack.
# These do NOT change when you re-run ./deploy/scripts/deploy.sh.
#
# Free trycloudflare.com URLs are NOT stable — use a named tunnel instead:
#   ./deploy/scripts/setup-stable-cloudflare-tunnel.sh app.yourdomain.com
# That writes deploy/public-url.env with your permanent https:// hostname.
#
# App (browser on this machine)
SAMPLE_APP_HOST=127.0.0.1
SAMPLE_APP_PORT=3000
SAMPLE_APP_URL=http://127.0.0.1:3000
SAMPLE_HEALTH_URL=http://127.0.0.1:3000/api/health

# Postgres for DBeaver / psql on this machine only
SAMPLE_DB_HOST=127.0.0.1
SAMPLE_DB_PORT=5434
