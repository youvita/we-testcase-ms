# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wetestcase?schema=public"

# Direct (non-pooled) connection, used only by `prisma migrate`. Locally this is
# the same database; on a serverless host DATABASE_URL is the pooler and this is
# the direct endpoint your provider gives you alongside it.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/wetestcase?schema=public"

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Public origin of the deployment, e.g. https://your-app.vercel.app — no
# trailing slash. Leave both unset locally and the app uses the request origin;
# set them in production so sign-in is not tied to whatever host answered.
# Anything not listed here is rejected by Better Auth's origin check with a 403.
BETTER_AUTH_URL="http://localhost:3000"

# Read by the browser and inlined at BUILD time, not at runtime — changing it
# on the host requires a fresh deploy to take effect.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Directory (relative to the project root, or absolute) where execution
# screenshots are stored. Files are served through an authenticated API route,
# never from /public.
#
# NOTE: this needs a writable, persistent disk. Serverless hosts (Vercel among
# them) give each invocation a read-only project directory and a /tmp that does
# not survive, so attachments need object storage there.
UPLOAD_DIR="./uploads"

# Max screenshot size in bytes (default 5 MB).
MAX_UPLOAD_BYTES="5242880"
