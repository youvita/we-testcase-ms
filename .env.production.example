# ---------------------------------------------------------------------------
# Production env for Mac mini + Cloudflare
# Copy to .env.production and fill in real values:
#   cp .env.production.example .env.production
# ---------------------------------------------------------------------------

# --- Postgres (Docker service on the Mac mini) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-long-random-password
POSTGRES_DB=wetestcase

# Used by host-side tools (DBeaver on 127.0.0.1:5434, backup scripts).
# Inside the app container these are overridden by docker-compose.prod.yml
# to use hostname "postgres".
DATABASE_URL="postgresql://postgres:change-me-long-random-password@127.0.0.1:5434/wetestcase?schema=public"
DIRECT_URL="postgresql://postgres:change-me-long-random-password@127.0.0.1:5434/wetestcase?schema=public"

# --- Better Auth ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# FREE (no domain): leave BOTH empty so the browser uses the tunnel host.
# Do NOT set them to http://localhost:3000 in production — login will break.
# With a fixed domain later: both = https://app.yourdomain.com (no trailing slash)
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=

# --- Uploads (container path; volume-mounted on the Mac) ---
UPLOAD_DIR="/app/uploads"
MAX_UPLOAD_BYTES="5242880"
