# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
# Host 5434 = docker compose maps host:5434 → container:5432 (see docker-compose.yml).
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/wetestcase?schema=public"

# Direct (non-pooled) connection, used only by `prisma migrate`. Locally this is
# the same database; on a serverless host DATABASE_URL is the pooler and this is
# the direct endpoint your provider gives you alongside it.
DIRECT_URL="postgresql://postgres:postgres@localhost:5434/wetestcase?schema=public"

# Database for `npm run test:db`. Every test empties it, so keep it separate
# from the one above; the tests refuse a name that does not end in _test.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5434/wetestcase_test?schema=public"

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Public origin of the deployment, e.g. https://app.example.com (Cloudflare)
# or https://your-app.vercel.app — no trailing slash. Leave both unset locally
# and the app uses the request origin; set them in production so sign-in is not
# tied to whatever host answered. Anything not listed here is rejected by
# Better Auth's origin check with a 403.
#
# Production on Mac mini + Cloudflare: see .env.production.example and
# deploy/README.md.
BETTER_AUTH_URL="http://localhost:3000"

# Read by the browser and inlined at BUILD time, not at runtime — changing it
# on the host requires a fresh deploy to take effect.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Directory (relative to the project root, or absolute) where execution
# screenshots are stored. Files are served through an authenticated API route,
# never from /public.
#
# NOTE: this needs a writable, persistent disk. On the Mac mini production stack
# Docker mounts a named volume at /app/uploads (see docker-compose.prod.yml).
# Serverless hosts (Vercel) give each invocation a read-only project directory
# and a /tmp that does not survive — object storage is required there instead.
UPLOAD_DIR="./uploads"

# Max screenshot size in bytes (default 5 MB).
MAX_UPLOAD_BYTES="5242880"

# ---------------------------------------------------------------------------
# AI (Claude)
# ---------------------------------------------------------------------------
# AI features run on each person's own Claude subscription, through the Claude
# bridge — the `claude` CLI behind the Messages API (scripts/claude-bridge.mjs).
# `docker compose up -d claude-bridge` starts it on 127.0.0.1:8788. Unset, the
# AI buttons report that AI is not set up; nothing else changes.
CLAUDE_BRIDGE_URL="http://127.0.0.1:8788"

# Model for AI jobs: a CLI alias (sonnet, opus, haiku) or a full model id.
# CLAUDE_MODEL="sonnet"

# Key that encrypts stored subscription tokens. Defaults to one derived from
# BETTER_AUTH_SECRET; changing whichever is used means everyone reconnects.
# CLAUDE_TOKEN_SECRET=""

# ---------------------------------------------------------------------------
# Automation runner
# ---------------------------------------------------------------------------
# Shared secret between the app and the runner (apps/runner). Unset = runs
# stay queued. `docker compose --profile automation up -d runner` uses
# "dev-runner-token" unless RUNNER_TOKEN is exported in your shell.
RUNNER_TOKEN="dev-runner-token"
